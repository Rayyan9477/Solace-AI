# Solace-AI deployment environment (IF-02).
# GENERATED from deploy/env/env-contract.yaml by: python -m deploy.env.render_env_example --write
# Do not edit by hand. Change the registry and re-render; tests/deploy/test_env_contract.py checks it.
#
# Secrets are blank here (a bcrypt hash shows '' to keep its quotes); never commit a real value. Single-quote any value that contains
# a $ (a bcrypt hash, for example) so compose does not interpolate it. Unset values fall back to
# the dev defaults shown; the strict profile (docker-compose.prod.yml) refuses to render while a
# source marked 'required in strict' is unset.

# --- environment ---
# secret: no | required in strict: yes | format: text | development, test, staging or production; staging and production are strict (D-14).
ENVIRONMENT=development

# --- auth ---
# secret: yes | required in strict: yes | format: urlsafe48 | HS256 key for service tokens and, until W4, user tokens; at least 32 characters. Replaces the JWT_SECRET_KEY interpolation name (IF-22).
AUTH_SECRET_KEY=
# secret: no | required in strict: no | format: text | HS256 until the W4 RS256 cut-over.
AUTH_ALGORITHM=HS256
# secret: no | required in strict: no | format: json | JSON {kid: public PEM} verification keyset; unused while AUTH_ALGORITHM=HS256.
AUTH_PUBLIC_KEYS_JSON=
# secret: no | required in strict: no | format: text | key id stamped into RS256 tokens; unused while AUTH_ALGORITHM=HS256.
AUTH_ACTIVE_KID=
# secret: no | required in strict: no | format: bool | false from W4.
AUTH_ACCEPT_LEGACY_HS256=true
# secret: yes | required in strict: no | format: pem | RS256 issuer key (user-service only), one line with \n escapes; unused while AUTH_ALGORITHM=HS256.
AUTH_PRIVATE_KEY_PEM=

# --- phi-audit ---
# secret: yes | required in strict: yes | format: hex64 | AES-256 master key, 64 hex characters (python -c "import secrets; print(secrets.token_hex(32))"); a raw 32-character value is development/test only (WS-09.1).
ENCRYPTION_MASTER_KEY=
# secret: yes | required in strict: yes | format: urlsafe48 | salt for deterministic PHI search hashes.
ENCRYPTION_SEARCH_HASH_SALT=
# secret: no | required in strict: no | format: text | id of the active master key, ^[A-Za-z0-9_-]{1,32}$.
ENCRYPTION_KEY_ID=k1
# secret: yes | required in strict: no | format: json | JSON {key_id: key}, decrypt-only; empty means no retired key.
ENCRYPTION_RETIRED_KEYS_JSON=
# secret: yes | required in strict: yes | format: urlsafe48 | audit chain HMAC key (P1-8).
AUDIT_HMAC_KEY=
# secret: yes | required in strict: yes | format: fernet | user-service token encryption key until PHI codec adoption
FERNET_TOKEN_KEY=
# secret: yes | required in strict: yes | format: fernet | user-service field encryption key until PHI codec adoption
FERNET_FIELD_KEY=
# secret: yes | required in strict: yes | format: urlsafe48 | user-service field encryption key, at least 32 characters. Replaces the FIELD_ENCRYPTION_KEY interpolation name (IF-22).
USER_SERVICE_FIELD_ENCRYPTION_KEY=

# --- database ---
# secret: yes | required in strict: yes | format: urlsafe24 | solace_app's password; init-db creates the role with it. URL-safe, because SAFETY_REPO_POSTGRES_DSN carries it. ProductionGuards requires it on every service in strict.
POSTGRES_PASSWORD=
# secret: no | required in strict: no | format: text | the development mode; the strict overlay always sets verify-full against host postgres (D-15).
POSTGRES_SSL_MODE=prefer
# secret: yes | required in strict: yes | format: urlsafe24 | the image superuser's password (init, ops and backups); never given to a service.
POSTGRES_SUPERUSER_PASSWORD=
# secret: yes | required in strict: yes | format: urlsafe24 | solace_migrator's password (the migrate job only); init-db creates the role with it. URL-safe, because DATABASE_URL carries it.
POSTGRES_MIGRATOR_PASSWORD=
# secret: no | required in strict: yes | format: text | profiles: strict | host directory holding one file per secret, mounted per service under /run/secrets/; W0 holds the Postgres TLS files from python -m scripts.db.gen_certs --out DIR --san postgres (postgres-ca.crt, server.crt, server.key). Compose interpolation only.
SOLACE_SECRETS_DIR=/run/solace/secrets

# --- redis ---
# secret: yes | required in strict: yes | format: urlsafe24 | the Redis server's requirepass and every client's password (one source, so a rotation reaches them all). URL-safe, because REDIS_URL carries it.
REDIS_PASSWORD=

# --- oauth ---
# secret: no | required in strict: no | format: text | Google sign-in is off unless both the client id and the client secret are set.
GOOGLE_OAUTH_CLIENT_ID=
# secret: yes | required in strict: no | format: urlsafe24 | Google OAuth client secret.
GOOGLE_OAUTH_CLIENT_SECRET=
# secret: no | required in strict: no | format: url | the localhost default is development only; strict is empty unless set.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/oauth/google/callback
# secret: no | required in strict: no | format: csv | origins the OAuth start redirect may return to; strict is empty unless set.
OAUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000

# --- llm ---
# secret: yes | required in strict: no | format: urlsafe48 | Portkey gateway key; empty keeps the LLM off.
LLM_PORTKEY_API_KEY=
# secret: no | required in strict: no | format: url | the test harness points it at fake-llm.
LLM_PORTKEY_GATEWAY_URL=https://api.portkey.ai/v1
# secret: yes | required in strict: no | format: urlsafe48 | provider key passed through the gateway; empty keeps the LLM off.
LLM_ANTHROPIC_API_KEY=
# secret: no | required in strict: no | format: bool | true only after the owner records the provider BAA (D-04).
LLM_PHI_EGRESS_APPROVED=false

# --- memory ---
# secret: no | required in strict: no | format: bool | Weaviate writes and vector retrieval (D-04); true needs the vector profile (docker compose --profile vector), otherwise retrieval stays keyword/BM25.
WEAVIATE_ENABLED=false
# secret: yes | required in strict: yes | format: urlsafe48 | Weaviate API key; Weaviate holds PHI-derived embeddings (P2-16).
WEAVIATE_API_KEY=

# --- notification ---
# secret: no | required in strict: no | format: text | SMTP relay host; mailhog is the dev sink (WS-03.6 renames the source and requires it in strict).
SMTP_HOST=mailhog
# secret: no | required in strict: no | format: int | SMTP relay port.
SMTP_PORT=1025

# --- edge ---
# secret: no | required in strict: yes | format: text | primary domain; strict Caddy serves api.<DOMAIN> and auth.<DOMAIN> with automatic HTTPS.
DOMAIN=localhost
# secret: no | required in strict: yes | format: email | ACME (Let's Encrypt) contact address.
CADDY_ADMIN_EMAIL=dev-ops@example.invalid
# secret: yes | required in strict: yes | format: bcrypt | bcrypt hash for the ops dashboards (caddy hash-password). Write it single-quoted in the env file (BASIC_AUTH_HASH='$2a$14$...'), because unquoted every $ starts an interpolation and the hash arrives mangled (MVP-117). The dev default is the hash of a discarded random password.
BASIC_AUTH_HASH=''
# secret: no | required in strict: no | format: text | profiles: dev | dev and test only: Caddy's orchestrator site address (an explicit http:// address); strict ignores it and uses api.<DOMAIN>
CADDY_API_SITE=http://api.localhost:8088
# secret: no | required in strict: no | format: text | profiles: dev | dev and test only: Caddy's user-service site address; strict ignores it and uses auth.<DOMAIN>
CADDY_AUTH_SITE=http://auth.localhost:8088
# secret: no | required in strict: yes | format: csv | comma-separated browser origins the edge services allow. Strict requires it (an edge service refuses to start with none, '*' or 'null').
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- observability ---
# secret: no | required in strict: no | format: text | the Grafana admin login
GRAFANA_ADMIN_USER=admin
# secret: yes | required in strict: yes | format: urlsafe24 | the Grafana admin password; no committed default, and the strict render fails without it.
GRAFANA_ADMIN_PASSWORD=
