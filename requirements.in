# Solace-AI runtime dependency inputs (WS-01.2, D-16). Python 3.12.
#
# This is the ONLY place runtime dependencies are declared. Compile it into the hash-pinned
# requirements.lock with:
#   uv pip compile requirements.in --universal --generate-hashes --python-version 3.12 -o requirements.lock
# (add -c <baseline constraints> so every transitive version matches the tested baseline, and
# --no-annotate so no constraint-file path is written into the lock, MVP-005).
#
# D-16: the pins below are the versions the local suites pass on. PyJWT >= 2.13 (MVP-359);
# python-jose is NOT a runtime dependency (dev lock only, for the frozen Kong tests, D-19);
# torch, transformers, VADER and spaCy are kept out of every image.
# Service extras are bare names in services/<svc>/requirements.txt and resolve here.
# WS-01.F1 (MVP-359): advisory-affected pins are raised to the lowest same-major fixed version;
# every advisory that stays open is listed with a reason and an expiry in scripts/ci/accepted_vulns.yaml.
# WS-01.F2 (D-16 security bumps, controller Ruling 2026-11-02): the checkpoint path and starlette moved to the
# lowest fixed release even across a major (langgraph-checkpoint 4.x, starlette 1.x, instrumentator 8.x).
# fastapi 0.133 rejects JSON bodies without a Content-Type header (strict_content_type=True, kept as CSRF hardening).

fastapi==0.133.0  # WS-01.F2: lowest fastapi without a starlette<1 cap (0.128.0-0.128.2 need <0.51, 0.128.3-0.132.1 need <1.0)
starlette==1.3.1  # WS-01.F2: lowest release that fixes all seven starlette advisories (PYSEC-2026-161, -248, -249, -2280, -2281, -1941, -1942)
uvicorn[standard]==0.40.0
pydantic==2.13.4
pydantic-settings==2.14.2  # WS-01.F2: lowest fix for GHSA-4xgf-cpjx-pc3j
