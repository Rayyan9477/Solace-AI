langgraph-checkpoint==4.1.1  # WS-01.F2: PYSEC-2026-2573 (fixed 4.1.1), PYSEC-2026-2574 (4.0.0); langgraph 1.0.10 allows <5
langgraph-checkpoint-postgres==3.1.1  # WS-01.F2: PYSEC-2026-3635 (3.1.3 needs checkpoint>=4.3.0); bump only with a slot-017 follow-up revision (WS-10)
langchain-core==1.3.3  # WS-01.F2: lowest fix for PYSEC-2026-2564 (no 1.2.x fix exists)
langchain-anthropic==1.3.1
portkey-ai~=1.9.0
weaviate-client==4.19.2
