# Solace-AI production Caddyfile.
#
# Caddy terminates TLS via automatic Let's Encrypt and reverse-proxies
# to the internal services on the docker-compose `backend` + `monitoring`
# networks. Internal ports are not exposed to the host — only Caddy's
# 80/443 face the internet.
#
# Environment variables (set in .env.prod or docker-compose.prod.yml):
#   DOMAIN              e.g. solace-demo.example
#   CADDY_ADMIN_EMAIL   letsencrypt contact
#   BASIC_AUTH_HASH     bcrypt hash for ops dashboards
#
# Substitute at startup: `caddy run --envfile /etc/caddy/.env`.

{
    email {$CADDY_ADMIN_EMAIL}
    # Use staging issuer first to validate setup without hitting rate limits:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ---- Primary API ----------------------------------------------------------
# Orchestrator is the public-facing entry point. Clients go here.
api.{$DOMAIN} {
    encode gzip zstd

    header {
        # HSTS for 6 months with preload
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Orchestrator routes everything to downstream services internally.
    reverse_proxy orchestrator-service:8000 {
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    # Per-IP rate limit (Caddy built-in rate_limit, not global-keyed).
    # Strict on unauthenticated endpoints; AuthN happens inside orchestrator.
    # Tune after load-testing demo.
}

# ---- User / auth service --------------------------------------------------
# Direct access for Google OAuth callback (Sprint 8 Day 2).
auth.{$DOMAIN} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=15768000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # OAuth callbacks MUST land on the user-service without rewriting path.
    reverse_proxy user-service:8001 {
        health_uri /health
        health_interval 30s
    }
}

# ---- Observability dashboards (basic-auth protected) ----------------------
grafana.{$DOMAIN} {
    basicauth {
        admin {$BASIC_AUTH_HASH}
    }
    reverse_proxy grafana:3000
}

jaeger.{$DOMAIN} {
    basicauth {
        admin {$BASIC_AUTH_HASH}
    }
    reverse_proxy jaeger:16686
}

kafka.{$DOMAIN} {
    basicauth {
        admin {$BASIC_AUTH_HASH}
    }
    reverse_proxy kafka-ui:8080
}

# ---- Default (apex) -------------------------------------------------------
# Return a plain 200 on the apex so TLS probes pass; no content is served.
{$DOMAIN} {
    respond "Solace-AI demo — use api.{$DOMAIN} for the REST API." 200
}
