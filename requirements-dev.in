# Solace-AI development and test dependency inputs (WS-01.2, D-16). Python 3.12.
#
# The dev lock is the runtime lock plus test and CI tools, at the same runtime versions. Compile with:
#   uv pip compile requirements-dev.in --universal --generate-hashes --python-version 3.12 -o requirements-dev.lock
# (add -c <baseline constraints> -c <runtime pins> so the runtime versions stay identical, and
# --no-annotate so no constraint-file path is written into the lock, MVP-005).

-r requirements.in

pytest==8.3.3
pytest-asyncio==1.3.0
pytest-timeout==2.4.0
pytest-cov==5.0.0
pytest-mock==3.15.1
hypothesis==6.165.10
fakeredis==2.36.1
# no redis extra: it requires redis>=7, which conflicts with the D-16 redis 5.3.x pin
testcontainers[postgres,kafka]==4.14.2
docker==7.1.0
websockets==15.0.1
faker==37.4.2
ruff==0.6.9
pip-audit==2.9.0
packaging==24.2
jsonschema==4.26.0  # WS-05 contract framework
cfn-lint==1.51.5  # WS-01.13, WS-03.11
python-jose[cryptography]==3.5.0  # test-only: frozen Kong auth_plugin tests (D-19); never in requirements.lock

# WS-01.F1 security floors for dev-only transitive dependencies (MVP-359, pip-audit of 2026-11-02): the lowest
# same-major fixed version; advisories that stay open are listed in scripts/ci/accepted_vulns.yaml.
filelock==3.20.3  # PYSEC-2026-1374, PYSEC-2026-1375 (via cachecontrol for pip-audit); 4.x-only fixes accepted
msgpack==1.2.3  # PYSEC-2026-3625, GHSA-j586-36cw-2gc2 (via cachecontrol)
pyasn1==0.6.5  # nine pyasn1 advisories, fixed by 0.6.5 (via python-jose and rsa)
pygments==2.20.0  # PYSEC-2026-2987 (via rich)
